# Backend: leave empty for local KML mode. Configure your own separate flood table.
AWS_REGION=
DYNAMODB_FLOOD_TABLE=

# Public OSRM demo server is best-effort. Use a managed or self-hosted service
# URL for production. Do not put provider secrets in VITE_* variables.
OSRM_BASE_URL=
FLOOD_HAZARD_BUFFER_METERS=
CORS_ORIGINS=
BENGALURU_SERVICE_AREA_GEOJSON=
BENGALURU_ROUTE_SNAP_TOLERANCE_METERS=
BENGALURU_ROUTE_BOUNDARY_TOLERANCE_METERS=

# Frontend: leave API base unset for the Vite /api proxy in local development.
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
